---
// Formularz zapytania z województwem (zgłoszenie trafia do przedstawiciela z regionu).
// MAKIETA: waliduje pola i pokazuje komunikaty przy polach, ale nie wysyła danych
// (wysyłkę podłączymy przy wdrożeniu). Używany na stronie głównej i w /kontakt.
import { siteSettings } from '../data/site';

const voivodeships = [
  'dolnośląskie', 'kujawsko-pomorskie', 'lubelskie', 'lubuskie', 'łódzkie', 'małopolskie', 'mazowieckie', 'opolskie',
  'podkarpackie', 'podlaskie', 'pomorskie', 'śląskie', 'świętokrzyskie', 'warmińsko-mazurskie', 'wielkopolskie', 'zachodniopomorskie',
];
---

<form class="form" novalidate data-contact-form>
  <div class="form__grid">
    <div class="field">
      <label for="f-name">Imię i nazwisko <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" autocomplete="name" required />
      <p class="field__error" id="f-name-err" hidden>Podaj imię i nazwisko.</p>
    </div>
    <div class="field">
      <label for="f-company">Firma</label>
      <input id="f-company" name="company" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="f-phone">Telefon <span aria-hidden="true">*</span></label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9 +()-]{9,}" />
      <p class="field__error" id="f-phone-err" hidden>Podaj numer telefonu (min. 9 cyfr).</p>
    </div>
    <div class="field">
      <label for="f-email">E-mail <span aria-hidden="true">*</span></label>
      <input id="f-email" name="email" type="email" autocomplete="email" required />
      <p class="field__error" id="f-email-err" hidden>Podaj poprawny adres e-mail.</p>
    </div>
    <div class="field field--full">
      <label for="f-region">Województwo <span aria-hidden="true">*</span></label>
      <select id="f-region" name="region" required>
        <option value="">Wybierz województwo</option>
        {voivodeships.map((v) => <option value={v}>{v}</option>)}
      </select>
      <p class="field__hint">Na tej podstawie odezwie się przedstawiciel z Twojego regionu.</p>
      <p class="field__error" id="f-region-err" hidden>Wybierz województwo.</p>
    </div>
    <div class="field field--full">
      <label for="f-msg">Czego potrzebujesz?</label>
      <textarea id="f-msg" name="message" rows="4" placeholder="Np. rodzaj olejów, maszyny lub pojazdy, przybliżone ilości"></textarea>
    </div>
  </div>

  <div class="consent">
    <input id="f-consent" name="consent" type="checkbox" required />
    <label for="f-consent">
      Wyrażam zgodę na przetwarzanie moich danych przez {siteSettings.legalName} w celu odpowiedzi na zapytanie.
      Szczegóły w <a href="/polityka-prywatnosci">Polityce prywatności</a>. <span aria-hidden="true">*</span>
    </label>
  </div>
  <p class="field__error" id="f-consent-err" hidden>Zaznacz zgodę, abyśmy mogli odpowiedzieć.</p>

  <button class="btn btn--primary form__submit" type="submit">Wyślij zapytanie</button>
  <p class="form__status" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  // Walidacja z czytelnymi komunikatami przy polach; wysyłka — do podłączenia.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  if (form) {
    const fields = ['f-name', 'f-phone', 'f-email', 'f-region', 'f-consent'];
    const check = (id: string) => {
      const el = form.querySelector<HTMLInputElement>(`#${id}`)!;
      const err = form.querySelector<HTMLElement>(`#${id}-err`)!;
      const ok = el.checkValidity();
      err.hidden = ok;
      el.setAttribute('aria-invalid', String(!ok));
      if (!ok) el.setAttribute('aria-describedby', `${id}-err`);
      else el.removeAttribute('aria-describedby');
      return ok;
    };
    fields.forEach((id) => {
      const el = form.querySelector<HTMLInputElement>(`#${id}`)!;
      el.addEventListener(el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true') check(id);
      });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const results = fields.map(check);
      if (results.includes(false)) {
        const first = fields[results.indexOf(false)];
        form.querySelector<HTMLElement>(`#${first}`)?.focus();
        if (status) status.textContent = '';
        return;
      }
      if (status) status.textContent = 'Formularz działa w wersji testowej — wysyłka zostanie podłączona przy wdrożeniu strony.';
    });
  }
</script>

<style>
  .form {
    margin-top: 2.5rem;
  }

  .form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.25rem;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-heading);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.75rem 1rem;
    border: 1px solid #b7c0c9;
    border-radius: var(--radius);
    background: #fff;
    font: inherit;
    color: var(--c-ink);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 3px solid var(--c-yellow);
    outline-offset: 0;
    border-color: var(--c-heading);
  }

  .field [aria-invalid='true'] {
    border-color: #b42318;
  }

  .field__hint {
    margin-top: 0.375rem;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .field__error {
    margin-top: 0.375rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: #b42318;
  }

  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .consent input {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    accent-color: var(--c-navy-900);
  }

  .consent a {
    color: var(--c-heading);
  }

  .form__submit {
    margin-top: 2rem;
  }

  .form__status {
    margin-top: 1rem;
    font-weight: 600;
    color: var(--c-heading);
  }

  .form__status:empty {
    display: none;
  }

  @media (max-width: 560px) {
    .form__grid {
      grid-template-columns: 1fr;
    }

    .form__submit {
      width: 100%;
    }
  }
</style>
