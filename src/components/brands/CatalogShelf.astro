---
// Półka katalogów PDF (#katalogi — link „Katalogi PDF” w nagłówku i stary adres
// /pliki-do-pobrania). Każdy katalog jako „okładka” dokumentu z zagiętym rogiem.
import { Image } from 'astro:assets';
import { brands } from '../../data/brands';

interface Props {
  heading: string;
  text?: string;
}

const { heading, text } = Astro.props;
const catalogs = brands.filter((b) => b.catalog);
---

<section class="section section--alt shelf" id="katalogi" aria-labelledby="shelf-heading">
  <div class="container">
    <div class="shelf__head">
      <h2 id="shelf-heading" class="shelf__title">{heading}</h2>
      {text && <p class="shelf__text">{text}</p>}
    </div>

    <ul class="shelf__list" role="list">
      {
        catalogs.map((b) => (
          <li>
            <a class="cover" href={b.catalog!.href} target="_blank" rel="noopener">
              <span class="cover__top">
                {b.logo ? <Image class="cover__logo" src={b.logo.src} alt="" width={286} height={82} /> : <span class="cover__word">{b.name}</span>}
              </span>
              <span class="cover__mid">
                <span class="cover__kind">Katalog produktów</span>
                <span class="cover__brand">{b.name}</span>
              </span>
              <svg class="cover__drop" viewBox="0 0 20 26" aria-hidden="true">
                <path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0z" fill="currentColor" />
              </svg>
              <span class="cover__foot">
                <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="2.2" />
                </svg>
                <span><span class="cover__verb">Pobierz </span>PDF</span>
                <span class="cover__size">{b.catalog!.size}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .shelf__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .shelf__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .shelf__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  .shelf__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Okładka: biała kartka z zagiętym prawym górnym rogiem */
  .cover {
    --fold: 34px;
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #fff;
    clip-path: polygon(0 0, calc(100% - var(--fold)) 0, 100% var(--fold), 100% 100%, 0 100%);
    color: var(--c-heading);
    text-decoration: none;
    box-shadow: 0 1px 0 var(--c-line);
    transition: transform 0.35s var(--ease);
  }

  .cover::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: var(--fold);
    height: var(--fold);
    background: linear-gradient(225deg, transparent 50%, #d5dbe1 50%);
  }

  .cover:hover {
    transform: translateY(-6px);
  }

  .cover__top {
    display: flex;
    align-items: center;
    min-height: 92px;
    padding: 1.75rem 1.5rem 0;
  }

  .cover :global(.cover__logo) {
    width: min(170px, 80%);
    height: auto;
  }

  .cover__word {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cover__mid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.25rem;
    margin-top: auto;
    padding: 0 1.5rem 1.5rem;
  }

  .cover__kind {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-muted);
  }

  .cover__brand {
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* duża kropla z logo jako znak wodny */
  .cover__drop {
    position: absolute;
    right: -12%;
    bottom: 16%;
    width: 58%;
    color: var(--c-bg-alt);
  }

  .cover__foot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 56px;
    padding: 0 1.5rem;
    background: var(--c-navy);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .cover__size {
    margin-left: auto;
    font-weight: 500;
    opacity: 0.85;
  }

  .cover:hover .cover__foot,
  .cover:focus-visible .cover__foot {
    background: var(--c-yellow);
    color: var(--c-navy-900);
  }

  /* obrys fokusu na elemencie listy (okładka jest przycięta clip-path) */
  .cover:focus-visible {
    outline: none;
  }

  .shelf__list li:has(.cover:focus-visible) {
    outline: 3px solid var(--c-navy-900);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover:hover {
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    .shelf__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .shelf__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .cover {
      aspect-ratio: auto;
      min-height: 250px;
    }

    .cover__top {
      padding: 1.25rem 1rem 0;
    }

    .cover__mid {
      padding: 1.5rem 1rem 1rem;
    }

    .cover__foot {
      gap: 0.375rem;
      padding: 0 0.875rem;
      font-size: var(--fs-small);
    }

    .cover__verb {
      display: none;
    }
  }
</style>
