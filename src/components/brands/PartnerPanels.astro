---
// Dwaj partnerzy (ORLEN OIL, Castrol) jako duże panele: logo, opis, kategorie
// oferty z linkami, certyfikat dystrybutora oraz katalog i dobornik.
import { Image } from 'astro:assets';
import { brands, brandCategories } from '../../data/brands';

interface Props {
  heading: string;
  text?: string;
}

const { heading, text } = Astro.props;
const partners = brands.filter((b) => b.partner);
---

<section class="section section--alt partners-b" aria-labelledby="partners-b-heading">
  <div class="container">
    <div class="pb__head">
      <h2 id="partners-b-heading" class="pb__title">{heading}</h2>
      {text && <p class="pb__text">{text}</p>}
    </div>

    <ul class="pb__list" role="list">
      {
        partners.map((brand) => (
          <li class="panel" id={brand.slug}>
            <div class="panel__logo">
              {brand.logo && <Image src={brand.logo.src} alt={brand.logo.alt} width={286} height={82} />}
            </div>

            <div class="panel__body">
              <div class="panel__copy">
                <h3 class="panel__name">{brand.name}</h3>
                <p class="panel__text">{brand.text}</p>
                <p class="panel__label">Kategorie w ofercie Maxol:</p>
                <ul class="panel__cats" role="list">
                  {brandCategories(brand).map((s) => (
                    <li>
                      <a href={`/oferta/${s.slug}`}>
                        <svg viewBox="0 0 20 26" width="9" height="12" aria-hidden="true">
                          <path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0z" fill="currentColor" />
                        </svg>
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              {brand.certificate && (
                <a class="cert-mini" href={brand.certificate.href} target="_blank" rel="noopener">
                  <span class="cert-mini__img">
                    <Image src={brand.certificate.image} alt={brand.certificate.alt} widths={[240, 480]} sizes="160px" />
                  </span>
                  <span class="cert-mini__label">
                    Certyfikat dystrybutora
                    <span class="cert-mini__meta">PDF, {brand.certificate.size}</span>
                  </span>
                </a>
              )}
            </div>

            <div class="panel__actions">
              {brand.catalog && (
                <a class="btn btn--primary" href={brand.catalog.href} target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="2.2" />
                  </svg>
                  Katalog PDF<span class="visually-hidden"> {brand.name}, {brand.catalog.size}</span>
                </a>
              )}
              {brand.finder && (
                <a class="link-arrow" href={brand.finder.href} target="_blank" rel="noopener">
                  Dobornik {brand.name}
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M4 10L10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                  <span class="visually-hidden"> (otwiera się w nowej karcie)</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pb__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .pb__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .pb__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  .pb__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel {
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: #fff;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .panel__logo {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.75rem) 2rem;
    border-bottom: 4px solid var(--c-yellow);
  }

  .panel__logo :global(img) {
    width: min(300px, 72%);
    height: auto;
  }

  .panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 2rem;
    padding: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
  }

  .panel__name {
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .panel__text {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--c-muted);
  }

  .panel__label {
    margin-top: 1.5rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-heading);
  }

  .panel__cats {
    display: grid;
    gap: 0.25rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .panel__cats a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }

  .panel__cats svg {
    flex: none;
    color: var(--c-yellow-600);
  }

  .panel__cats a:hover {
    color: var(--c-heading);
    text-decoration: underline;
  }

  /* Miniatura certyfikatu */
  .cert-mini {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    width: 160px;
    text-decoration: none;
  }

  .cert-mini__img {
    display: grid;
    place-items: center;
    height: 180px;
    padding: 0.75rem;
    background: var(--c-bg-alt);
    transition: background-color 0.2s var(--ease);
  }

  .cert-mini__img :global(img) {
    max-height: 100%;
    width: auto;
    box-shadow: 0 6px 18px -8px rgb(6 43 73 / 0.45);
  }

  .cert-mini:hover .cert-mini__img {
    background: #e7ebef;
  }

  .cert-mini__label {
    display: grid;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-heading);
  }

  .cert-mini:hover .cert-mini__label {
    text-decoration: underline;
  }

  .cert-mini__meta {
    font-weight: 500;
    color: var(--c-muted);
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding: 1.5rem clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
    border-top: 1px solid var(--c-bg-alt);
  }

  @media (max-width: 1100px) {
    .pb__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .pb__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .panel__body {
      grid-template-columns: 1fr;
    }

    .cert-mini {
      width: 100%;
      grid-template-columns: 96px 1fr;
      align-items: center;
    }

    .cert-mini__img {
      height: 110px;
      padding: 0.5rem;
    }
  }
</style>
