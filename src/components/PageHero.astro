---
// Nagłówek podstrony w stylu „Oferty” i „O nas”: białe tło, okruszki, duże H1,
// wstęp, miejsce na przyciski/listę (slot) i opcjonalnie zdjęcie dochodzące
// do prawej krawędzi ekranu albo dowolna prawa kolumna (slot „aside”).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  image?: { src: ImageMetadata; alt: string };
  /** xl — krótkie tytuły (np. „Kontakt”), lg — dłuższe (kategorie, wpisy) */
  size?: 'xl' | 'lg';
  imagePosition?: string;
}

const { title, lead, crumbs = [], image, size = 'xl', imagePosition = '50% 50%' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['phero', `phero--${size}`, { 'phero--image': image, 'phero--aside': hasAside }]} aria-labelledby="phero-title">
  <div class="container phero__grid">
    <div class="phero__copy">
      <Breadcrumbs items={crumbs} />
      <h1 id="phero-title" class="phero__title">{title}</h1>
      {lead && <p class="phero__lead">{lead}</p>}
      <slot />
    </div>

    {
      image && (
        <div class="phero__media">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[640, 960, 1400, 1800]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            style={`object-position: ${imagePosition}`}
          />
        </div>
      )
    }

    {
      hasAside && (
        <div class="phero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3.5rem, 2.5rem + 4vw, 6rem);
    overflow-x: clip;
  }

  .phero__grid {
    display: grid;
    gap: 2.5rem clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* prawa kolumna zaczyna się na wysokości H1 (pod okruszkami) */
  .phero--aside .phero__grid {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }

  .phero__aside {
    padding-top: 3.4rem;
  }

  .phero__title {
    color: var(--c-heading);
  }

  .phero--xl .phero__title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .phero--lg .phero__title {
    max-width: 18ch;
    font-size: clamp(2.375rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .phero__lead {
    max-width: 52ch;
    margin-top: 1.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    color: var(--c-muted);
  }

  /* Wariant ze zdjęciem: tekst po lewej, zdjęcie do prawej krawędzi okna */
  .phero--image {
    padding-bottom: 0;
  }

  .phero--image .phero__grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .phero--image .phero__copy {
    align-self: center;
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .phero__media {
    position: relative;
    min-height: clamp(420px, 34vw, 620px);
    margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
    background: var(--c-navy-900);
  }

  .phero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* żółty pasek przy dolnej krawędzi zdjęcia — jak linia pod nagłówkiem strony */
  .phero__media::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(96px, 12vw, 180px);
    height: 6px;
    background: var(--c-yellow);
  }

  @media (max-width: 900px) {
    .phero--aside .phero__grid,
    .phero--image .phero__grid {
      grid-template-columns: 1fr;
    }

    .phero--image .phero__copy {
      padding-bottom: 0;
    }

    .phero__aside {
      padding-top: 0;
    }

    .phero__media {
      min-height: 0;
      aspect-ratio: 3 / 2;
      margin-inline: calc(-1 * var(--gutter));
    }
  }
</style>
