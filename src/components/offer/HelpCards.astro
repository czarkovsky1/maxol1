---
// „Nie wiesz, co wybrać?”: dwie drogi samodzielnego doboru — doborniki producentów i katalogi PDF.

interface Props {
  heading: string;
  text?: string;
}

const { heading, text } = Astro.props;
---

<section class="section help" aria-labelledby="help-heading">
  <div class="container">
    <div class="help__head">
      <h2 id="help-heading" class="help__title">{heading}</h2>
      {text && <p class="help__text">{text}</p>}
    </div>

    <div class="help__grid">
      <a class="hcard hcard--yellow" href="/dobierz-olej">
        <h3 class="hcard__title">Dobierz olej do pojazdu</h3>
        <p class="hcard__text">Doborniki producentów Castrol, ORLEN OIL, Total i Shell wskażą olej do konkretnego modelu.</p>
        <span class="hcard__more">
          Przejdź do doborników
          <svg width="20" height="20" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </span>
      </a>

      <a class="hcard hcard--grey" href="/marki#katalogi">
        <h3 class="hcard__title">Pobierz katalogi producentów</h3>
        <p class="hcard__text">Aktualne katalogi ORLEN OIL, Castrol, Shell i Quator w PDF, z pełną gamą produktów.</p>
        <span class="hcard__more">
          Katalogi PDF
          <svg width="20" height="20" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .help__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .help__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .help__text {
    max-width: 50ch;
    color: var(--c-muted);
  }

  .help__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .hcard {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    color: var(--c-navy-900);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s var(--ease);
  }

  .hcard:hover {
    transform: translateY(-4px);
  }

  .hcard--yellow {
    background: var(--c-yellow);
  }

  .hcard--grey {
    background: var(--c-bg-alt);
  }

  .hcard__title {
    max-width: 16ch;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
  }

  .hcard__text {
    max-width: 44ch;
    margin-top: 1rem;
  }

  .hcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 2rem;
    font-weight: 800;
  }

  .hcard__more svg {
    transition: transform 0.2s var(--ease);
  }

  .hcard:hover .hcard__more svg {
    transform: translateX(5px);
  }

  .hcard:focus-visible {
    outline-color: var(--c-navy-900);
  }

  @media (prefers-reduced-motion: reduce) {
    .hcard:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .help__head,
    .help__grid {
      grid-template-columns: 1fr;
    }

    .hcard {
      min-height: 0;
    }
  }
</style>
