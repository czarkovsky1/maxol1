---
// Certyfikaty autoryzowanego dystrybutora: miniatura + link do PDF.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  text?: string;
  items: readonly { title: string; image: ImageMetadata; alt: string; pdf: string; size: string }[];
}

const { heading, text, items } = Astro.props;
---

<section class="section certs" id="certyfikaty" aria-labelledby="certs-heading">
  <div class="container certs__inner">
    <div>
      <h2 id="certs-heading" class="certs__title">{heading}</h2>
      {text && <p class="certs__text">{text}</p>}
    </div>
    <ul class="certs__list" role="list">
      {
        items.map((c) => (
          <li>
            <a class="cert" href={c.pdf} target="_blank" rel="noopener">
              <span class="cert__img">
                <Image src={c.image} alt={c.alt} widths={[320, 640]} sizes="(max-width: 700px) 45vw, 260px" />
              </span>
              <span class="cert__title">{c.title}</span>
              <span class="cert__meta">PDF, {c.size}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2.5rem 5rem;
    align-items: center;
  }

  .certs__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .certs__text {
    max-width: 46ch;
    margin-top: 1.25rem;
    color: var(--c-muted);
  }

  .certs__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert {
    display: grid;
    gap: 0.375rem;
    text-decoration: none;
  }

  .cert__img {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 1rem;
    background: var(--c-bg-alt);
    overflow: hidden;
  }

  .cert__img img {
    max-height: 100%;
    width: auto;
    box-shadow: 0 10px 30px -18px rgb(6 43 73 / 0.5);
    transition: transform 0.4s var(--ease);
  }

  .cert:hover .cert__img img {
    transform: scale(1.03);
  }

  .cert__title {
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--c-heading);
  }

  .cert:hover .cert__title {
    text-decoration: underline;
  }

  .cert__meta {
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .certs__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
