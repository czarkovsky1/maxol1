---
// „Kim jesteśmy” jako scrollytelling: po prawej rozdziały z dużą liczbą,
// po lewej przyklejone zdjęcie, które zmienia się razem z czytanym rozdziałem.
// Na telefonie: zdjęcie nad każdym rozdziałem, bez przyklejania.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  chapters: readonly {
    figure: string;
    unit?: string;
    title: string;
    paragraphs: readonly string[];
    note?: string;
    image: { src: ImageMetadata; alt: string };
  }[];
}

const { heading, chapters } = Astro.props;
---

<section class="story" aria-labelledby="story-heading" data-story>
  <div class="container">
    <h2 id="story-heading" class="story__heading">{heading}</h2>

    <div class="story__grid">
      <div class="story__media" aria-hidden="true">
        <div class="story__frame">
          {
            chapters.map((c, i) => (
              <Image
                class:list={['story__img', { 'is-active': i === 0 }]}
                src={c.image.src}
                alt=""
                widths={[640, 1000, 1400]}
                sizes="(max-width: 900px) 1px, 44vw"
                data-story-img
              />
            ))
          }
        </div>
        <ol class="story__progress">
          {chapters.map((_, i) => <li class:list={{ 'is-active': i === 0 }} data-story-dot />)}
        </ol>
      </div>

      <ol class="story__chapters">
        {
          chapters.map((c, i) => (
            <li class:list={['chapter', { 'is-active': i === 0 }]} data-story-chapter>
              <div class="chapter__mobile-img">
                <Image src={c.image.src} alt={c.image.alt} widths={[480, 800]} sizes="100vw" />
              </div>
              <p class="chapter__figure">
                {c.figure}
                {c.unit && <span class="chapter__unit">{c.unit}</span>}
              </p>
              <h3 class="chapter__title">{c.title}</h3>
              {c.paragraphs.map((p) => (
                <p class="chapter__text">{p}</p>
              ))}
              {c.note && <p class="chapter__note">{c.note}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Aktywny rozdział = ten, który przecina środek ekranu.
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((story) => {
    const chapters = [...story.querySelectorAll<HTMLElement>('[data-story-chapter]')];
    const imgs = [...story.querySelectorAll<HTMLElement>('[data-story-img]')];
    const dots = [...story.querySelectorAll<HTMLElement>('[data-story-dot]')];
    const setActive = (index: number) => {
      [chapters, imgs, dots].forEach((list) => list.forEach((el, i) => el.classList.toggle('is-active', i === index)));
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(chapters.indexOf(entry.target as HTMLElement));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    chapters.forEach((c) => io.observe(c));
  });
</script>

<style>
  .story {
    padding-block: var(--section-y);
  }

  .story__heading {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 4vw, 7rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  /* --- Zdjęcie przyklejone po lewej --- */
  .story__media {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
  }

  .story__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: calc(100vh - var(--header-h) - 6rem);
    overflow: hidden;
    background: var(--c-navy-900);
  }

  .story__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.7s var(--ease),
      transform 1.2s var(--ease);
  }

  .story__img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .story__progress {
    display: grid;
    grid-auto-flow: column;
    gap: 6px;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .story__progress li {
    height: 3px;
    background: var(--c-line);
    transition: background-color 0.4s var(--ease);
  }

  .story__progress li.is-active {
    background: var(--c-yellow);
  }

  /* --- Rozdziały --- */
  .story__chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 78vh;
    padding-block: 2rem;
    opacity: 0.35;
    transition: opacity 0.5s var(--ease);
  }

  .chapter.is-active {
    opacity: 1;
  }

  .chapter__mobile-img {
    display: none;
  }

  .chapter__figure {
    font-size: clamp(4rem, 2.5rem + 6vw, 8.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--c-heading);
  }

  .chapter__unit {
    margin-left: 0.15em;
    font-size: 0.32em;
    letter-spacing: -0.01em;
  }

  .chapter__title {
    max-width: 22ch;
    margin-top: 1.5rem;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    color: var(--c-heading);
  }

  .chapter__text {
    max-width: 52ch;
    margin-top: 1rem;
    font-size: 1.0625rem;
    color: var(--c-muted);
  }

  .chapter__note {
    max-width: 52ch;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 3px solid var(--c-yellow);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-heading);
  }

  @media (prefers-reduced-motion: reduce) {
    .story__img {
      transform: none;
      transition: opacity 0.01ms;
    }
  }

  @media (max-width: 900px) {
    .story__grid {
      grid-template-columns: 1fr;
    }

    .story__media {
      display: none;
    }

    .chapter {
      min-height: 0;
      padding-block: 0 3.5rem;
      opacity: 1;
    }

    .chapter__mobile-img {
      display: block;
      aspect-ratio: 16 / 10;
      margin-bottom: 1.75rem;
      overflow: hidden;
    }

    .chapter__mobile-img :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
