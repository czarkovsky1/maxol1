---
// Zaplecze jako mozaika zdjęć: jeden wysoki kafel, jeden szeroki, dwa mniejsze.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  text?: string;
  tiles: readonly { title: string; text: string; image: { src: ImageMetadata; alt: string } }[];
}

const { heading, text, tiles } = Astro.props;
---

<section class="mosaic" id="zaplecze" aria-labelledby="mosaic-heading">
  <div class="container">
    <div class="mosaic__head">
      <h2 id="mosaic-heading" class="mosaic__title">{heading}</h2>
      {text && <p class="mosaic__text">{text}</p>}
    </div>

    <ul class="mosaic__grid" role="list">
      {
        tiles.map((t, i) => (
          <li class={`tile tile--${i + 1}`}>
            <Image src={t.image.src} alt={t.image.alt} widths={[480, 800, 1200]} sizes={i === 0 || i === 1 ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 900px) 100vw, 30vw'} />
            <div class="tile__body">
              <h3 class="tile__title">{t.title}</h3>
              <p class="tile__text">{t.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mosaic {
    padding-block: var(--section-y);
    background: var(--c-navy-900);
    color: #fff;
  }

  .mosaic__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .mosaic__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
  }

  .mosaic__text {
    max-width: 50ch;
    color: rgb(255 255 255 / 0.78);
  }

  .mosaic__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    grid-template-rows: repeat(2, clamp(240px, 26vw, 360px));
    grid-template-areas:
      'a b b'
      'a c d';
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    overflow: hidden;
    background: #0b2f4d;
  }

  .tile--1 {
    grid-area: a;
  }

  .tile--2 {
    grid-area: b;
  }

  .tile--3 {
    grid-area: c;
  }

  .tile--4 {
    grid-area: d;
  }

  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .tile:hover :global(img) {
    transform: scale(1.05);
  }

  /* Gradient pod tekstem: biały tekst > 7:1 na najjaśniejszym fragmencie */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(4 22 38 / 0.92) 0%, rgb(4 22 38 / 0.55) 40%, rgb(4 22 38 / 0) 72%);
  }

  .tile__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .tile__title {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.75rem);
  }

  .tile__text {
    max-width: 40ch;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.85);
  }

  @media (max-width: 900px) {
    .mosaic__head {
      grid-template-columns: 1fr;
    }

    .mosaic__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas: none;
      grid-auto-rows: 300px;
    }

    .tile--1,
    .tile--2,
    .tile--3,
    .tile--4 {
      grid-area: auto;
    }
  }
</style>
