---
// Hero strony „O nas”: duże H1 nawiązujące do hasła z logo („Partner w olejach”)
// + kolaż trzech nachodzących na siebie zdjęć.
import { Image } from 'astro:assets';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead: string;
  images: readonly { src: ImageMetadata; alt: string }[];
}

const { title, lead, images } = Astro.props;
const [big, mid, small] = images;
---

<section class="ahero" aria-labelledby="ahero-title">
  <div class="container ahero__grid">
    <div class="ahero__copy">
      <Breadcrumbs items={[{ label: 'O nas' }]} />
      <h1 id="ahero-title" class="ahero__title" set:html={title} />
      <p class="ahero__lead">{lead}</p>
      <div class="ahero__actions">
        <a class="btn btn--primary" href="/kontakt">Zapytaj o ofertę</a>
        <a class="link-arrow" href="#zaplecze">
          Poznaj nasze zaplecze
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M9 3v11M4.5 10L9 14.5 13.5 10" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </a>
      </div>
    </div>

    <div class="collage">
      <figure class="collage__item collage__item--big">
        <Image src={big.src} alt={big.alt} widths={[640, 960, 1400]} sizes="(max-width: 900px) 90vw, 46vw" loading="eager" fetchpriority="high" />
      </figure>
      <figure class="collage__item collage__item--mid">
        <Image src={mid.src} alt={mid.alt} widths={[400, 800]} sizes="(max-width: 900px) 50vw, 26vw" loading="eager" />
      </figure>
      <figure class="collage__item collage__item--small">
        <Image src={small.src} alt={small.alt} widths={[320, 640]} sizes="(max-width: 900px) 36vw, 18vw" loading="eager" />
      </figure>
    </div>
  </div>
</section>

<style>
  .ahero {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(4rem, 3rem + 5vw, 7.5rem);
    overflow: hidden;
  }

  .ahero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 3rem clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }





  .ahero__title {
    max-width: 11ch;
    font-size: clamp(2.75rem, 1.6rem + 4.8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--c-heading);
  }

  .ahero__lead {
    max-width: 44ch;
    margin-top: 1.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    color: var(--c-muted);
  }

  .ahero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  /* Kolaż: duże zdjęcie u góry po prawej, dwa mniejsze nachodzą od dołu */
  .collage {
    position: relative;
    aspect-ratio: 1 / 1.02;
  }

  .collage__item {
    position: absolute;
    margin: 0;
    overflow: hidden;
    background: var(--c-navy-900);
    animation: rise 0.9s var(--ease) both;
  }

  .collage__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collage__item--big {
    top: 0;
    right: 0;
    width: 82%;
    height: 72%;
  }

  .collage__item--mid {
    left: 0;
    bottom: 0;
    width: 54%;
    height: 42%;
    box-shadow: 0 0 0 8px #fff;
    animation-delay: 0.15s;
  }

  .collage__item--small {
    right: 4%;
    bottom: 3%;
    width: 36%;
    height: 27%;
    box-shadow: 0 0 0 8px #fff;
    animation-delay: 0.3s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collage__item {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .ahero__grid {
      grid-template-columns: 1fr;
    }

    .collage {
      aspect-ratio: 1 / 0.9;
    }
  }
</style>
