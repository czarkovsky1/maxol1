---
// Blok „Zaplecze”: ciemna sekcja z głównym wyróżnikiem w nagłówku,
// zdjęciem i czterema konkretnymi przewagami (fakty ze strony klienta).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  text?: string;
  image: { src: ImageMetadata; alt: string; caption?: string };
  items: readonly { title: string; text: string }[];
  cta?: { label: string; href: string };
}

const { heading, text, image, items, cta } = Astro.props;
---

<section class="facilities" aria-labelledby="facilities-heading">
  <div class="container facilities__inner">
    <figure class="facilities__media">
      <Image src={image.src} alt={image.alt} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 45vw" />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>

    <div class="facilities__content">
      <h2 id="facilities-heading" class="facilities__title">{heading}</h2>
      {text && <p class="facilities__text">{text}</p>}

      <dl class="facilities__list">
        {
          items.map((item) => (
            <div class="facility">
              <dt class="facility__title">{item.title}</dt>
              <dd class="facility__text">{item.text}</dd>
            </div>
          ))
        }
      </dl>

      {cta && <a class="btn btn--primary facilities__cta" href={cta.href}>{cta.label}</a>}
    </div>
  </div>
</section>

<style>
  .facilities {
    padding-block: var(--section-y);
    background: var(--c-navy-900);
    color: #fff;
  }

  .facilities__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: center;
  }

  .facilities__media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .facilities__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facilities__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.75rem 1.25rem;
    background: var(--c-yellow);
    color: var(--c-navy-900);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .facilities__title {
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .facilities__text {
    max-width: 52ch;
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 0.78);
  }

  .facilities__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem 2.5rem;
    margin: clamp(2.5rem, 2rem + 1.5vw, 3.5rem) 0 0;
  }

  .facility__title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .facility__text {
    margin: 0.5rem 0 0;
    color: rgb(255 255 255 / 0.75);
  }

  .facilities__cta {
    margin-top: clamp(2.5rem, 2rem + 1.5vw, 3.5rem);
  }

  @media (max-width: 900px) {
    .facilities__inner {
      grid-template-columns: 1fr;
    }

    .facilities__media {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 560px) {
    .facilities__list {
      grid-template-columns: 1fr;
    }
  }
</style>
