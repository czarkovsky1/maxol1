---
// Blok „FAQ”: natywny akordeon <details>/<summary> — działa bez JavaScriptu,
// z klawiatury i z czytnikami ekranu. Później z tych pól wygenerujemy FAQPage (JSON-LD).
import { siteSettings } from '../../data/site';

interface Props {
  heading: string;
  text?: string;
  items: readonly { question: string; answer: string }[];
}

const { heading, text, items } = Astro.props;
---

<section class="section section--alt faq" aria-labelledby="faq-heading">
  <div class="container faq__inner">
    <div class="faq__intro">
      <h2 id="faq-heading" class="faq__title">{heading}</h2>
      {text && <p class="faq__text">{text}</p>}
      <a class="faq__phone" href={siteSettings.phone.href}>
        <span>Nie ma tu Twojego pytania? Zadzwoń:</span>
        <strong>{siteSettings.phone.display}</strong>
      </a>
    </div>

    <div class="faq__list">
      {
        items.map((item, i) => (
          <details class="qa" open={i === 0}>
            <summary class="qa__q">
              <span>{item.question}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <div class="qa__a">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: start;
  }

  .faq__title {
    max-width: 14ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .faq__text {
    max-width: 42ch;
    margin-top: 1.5rem;
    color: var(--c-muted);
  }

  .faq__phone {
    display: grid;
    gap: 0.25rem;
    margin-top: 2rem;
    color: var(--c-muted);
    text-decoration: none;
  }

  .faq__phone strong {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-heading);
  }

  .faq__phone:hover strong {
    text-decoration: underline;
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }

  .qa {
    background: #fff;
  }

  .qa__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
    padding: 1.125rem 1.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-heading);
    cursor: pointer;
    list-style: none;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q:focus-visible {
    outline-offset: -3px;
  }

  /* Plus zamieniający się w minus */
  .qa__icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 0;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__icon::after {
    transform: rotate(0deg);
  }

  .qa__a {
    padding: 0 1.5rem 1.5rem;
    color: var(--c-muted);
  }

  .qa__a p {
    max-width: 64ch;
  }

  @media (max-width: 900px) {
    .faq__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
