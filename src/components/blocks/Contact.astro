---
// Blok „Kontakt” strony głównej: formularz zapytania (ContactForm — makieta)
// + dane kontaktowe: dział handlowy, adres, działy, przedstawiciele.
import { siteSettings } from '../../data/site';
import ContactForm from '../ContactForm.astro';

interface Props {
  anchor?: string;
  heading: string;
  text?: string;
  departments: readonly { name: string; phones: readonly string[]; email?: string }[];
  reps: readonly { name: string; phone: string; email: string }[];
}

const { anchor, heading, text, departments, reps } = Astro.props;

const tel = (p: string) => `tel:+48${p.replace(/\D/g, '')}`;
---

<section class="section contact" id={anchor} aria-labelledby="contact-heading">
  <div class="container contact__inner">
    <div class="contact__form-wrap">
      <h2 id="contact-heading" class="contact__title">{heading}</h2>
      {text && <p class="contact__text">{text}</p>}

      <ContactForm />
    </div>

    <aside class="contact__info" aria-label="Dane kontaktowe">
      <div class="info-block">
        <h3 class="info-block__title">Dział handlowy</h3>
        <a class="info-big" href={siteSettings.phone.href}>{siteSettings.phone.display}</a>
        <a class="info-mail" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
      </div>

      <div class="info-block">
        <h3 class="info-block__title">Adres</h3>
        <p>
          {siteSettings.legalName}<br />
          {siteSettings.address.street}<br />
          {siteSettings.address.postalCode} {siteSettings.address.city}
        </p>
      </div>

      <div class="info-block">
        <h3 class="info-block__title">Działy</h3>
        <ul class="info-list" role="list">
          {
            departments.map((d) => (
              <li>
                <span class="info-list__name">{d.name}</span>
                <span>
                  {d.phones.map((p, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={tel(p)}>{p}</a>
                    </>
                  ))}
                  {d.email && (
                    <>
                      <br />
                      <a href={`mailto:${d.email}`}>{d.email}</a>
                    </>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="info-block">
        <h3 class="info-block__title">Przedstawiciele handlowi</h3>
        <ul class="info-list" role="list">
          {
            reps.map((r) => (
              <li>
                <span class="info-list__name">{r.name}</span>
                <span>
                  <a href={tel(r.phone)}>{r.phone}</a>
                  <br />
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>


<style>
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: start;
  }

  .contact__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .contact__text {
    max-width: 52ch;
    margin-top: 1.25rem;
    color: var(--c-muted);
  }

  /* Dane kontaktowe */
  .contact__info {
    display: grid;
    gap: 2rem;
    padding: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    background: var(--c-bg-alt);
  }

  .info-block__title {
    margin-bottom: 0.625rem;
    font-size: 1rem;
    color: var(--c-heading);
  }

  .info-big {
    display: block;
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-heading);
    text-decoration: none;
  }

  .info-mail {
    display: inline-block;
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--c-heading);
  }

  .info-block p,
  .info-list {
    color: var(--c-muted);
  }

  .info-list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .info-list li {
    display: grid;
    gap: 0.125rem;
  }

  .info-list__name {
    font-weight: 700;
    color: var(--c-ink);
  }

  .info-list a {
    color: inherit;
  }

  .info-list a:hover,
  .info-mail:hover {
    color: var(--c-heading);
  }

  @media (max-width: 1000px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }

</style>
