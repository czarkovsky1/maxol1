---
// Blok „Hero z kroplą” (wariant testowy na /o-nas): kropla oleju liczona na żywo
// w three.js. Sekcja jest wyższa niż ekran: scena „przykleja się” (sticky),
// a przewijanie napędza przelewanie strugi do następnej sekcji.
// Bez WebGL / przy „ogranicz ruch”: zwykła wysokość i statyczny kadr.

interface Props {
  heading: string;
  text?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { heading, text, primaryCta, secondaryCta } = Astro.props;
---

<section class="hero-liquid" aria-labelledby="hero-heading" data-hero-liquid>
  <div class="hero-liquid__stage" data-stage>
    <canvas class="hero-liquid__canvas" aria-hidden="true"></canvas>

    <div class="container hero-liquid__content">
      <h1 id="hero-heading" class="hero-liquid__title">{heading}</h1>
      {text && <p class="hero-liquid__text">{text}</p>}
      <div class="hero-liquid__actions">
        {primaryCta && <a class="btn btn--primary" href={primaryCta.href}>{primaryCta.label}</a>}
        {secondaryCta && <a class="btn btn--ghost-light" href={secondaryCta.href}>{secondaryCta.label}</a>}
      </div>
    </div>

    <button class="hero-liquid__toggle" type="button" aria-pressed="false" data-liquid-toggle hidden>
      <svg class="icon-pause" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="3" y="2" width="3.5" height="12" fill="currentColor"></rect>
        <rect x="9.5" y="2" width="3.5" height="12" fill="currentColor"></rect>
      </svg>
      <svg class="icon-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 2l10 6-10 6z" fill="currentColor"></path>
      </svg>
      <span class="visually-hidden" data-liquid-toggle-label>Zatrzymaj animację w tle</span>
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-liquid]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function boot() {
    if (!root) return;
    import('../../scripts/liquid/LiquidHero').then(({ initLiquidHero }) => {
      const hero = initLiquidHero(root, { reducedMotion });
      if (!hero) {
        root.classList.add('no-webgl');
        return;
      }
      const toggle = root.querySelector<HTMLButtonElement>('[data-liquid-toggle]');
      const label = root.querySelector<HTMLElement>('[data-liquid-toggle-label]');
      if (toggle && !reducedMotion) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const paused = toggle.getAttribute('aria-pressed') !== 'true';
          hero.setPaused(paused);
          toggle.setAttribute('aria-pressed', String(paused));
          if (label) label.textContent = paused ? 'Wznów animację w tle' : 'Zatrzymaj animację w tle';
        });
      }
    });
  }

  // Najpierw strona i tekst (LCP), potem 3D w wolnej chwili przeglądarki
  const idle = (cb: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 200);
  if (document.readyState === 'complete') idle(boot);
  else window.addEventListener('load', () => idle(boot), { once: true });
</script>

<style>
  .hero-liquid {
    --p: 0;
    position: relative;
    height: max(640px, 100svh);
    background: var(--c-navy-900);
    color: #fff;
  }

  /* Dodatkowe 75% wysokości ekranu na przelewanie przy przewijaniu */
  @media (prefers-reduced-motion: no-preference) {
    .hero-liquid {
      height: calc(max(640px, 100svh) + 75svh);
    }
  }

  .hero-liquid.no-webgl {
    height: max(640px, 100svh);
  }

  .hero-liquid__stage {
    position: sticky;
    top: 0;
    display: flex;
    align-items: flex-end;
    height: max(640px, 100svh);
    overflow: hidden;
    /* Tło zanim załaduje się WebGL: ten sam granat i halo co w shaderze */
    background:
      radial-gradient(ellipse 45% 55% at 71% 42%, rgb(10 74 124 / 0.55), transparent 70%),
      linear-gradient(to top right, #04192b, var(--c-navy-900) 55%);
  }

  .hero-liquid__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero-liquid.is-ready .hero-liquid__canvas {
    opacity: 1;
  }

  .hero-liquid__content {
    position: relative;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(4rem, 3rem + 5vw, 7.5rem);
    opacity: clamp(0, calc(1 - var(--p) * 3.4), 1);
    transform: translate3d(0, calc(var(--p) * -90px), 0);
    pointer-events: none;
  }

  .hero-liquid__content > * {
    pointer-events: auto;
  }

  .hero-liquid.is-pouring .hero-liquid__content {
    visibility: hidden;
  }

  .hero-liquid__title {
    max-width: 14ch;
    font-size: var(--fs-h1);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero-liquid__text {
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.88);
  }

  .hero-liquid__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-liquid__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(4rem, 3rem + 5vw, 7.5rem);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    opacity: clamp(0, calc(1 - var(--p) * 3.4), 1);
  }

  /* Desktop: blok tekstu (i wyrównana z nim kropla) wyśrodkowany w pionie
     pod nawigacją, lekko przesunięty w górę */
  @media (min-width: 768px) {
    .hero-liquid__stage {
      align-items: center;
    }

    .hero-liquid__content {
      padding-top: var(--header-h);
      padding-bottom: clamp(3rem, 13vh, 9rem);
    }
  }

  .hero-liquid__toggle:hover {
    border-color: #fff;
  }

  .hero-liquid__toggle .icon-play,
  .hero-liquid__toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .hero-liquid__toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  .hero-liquid.is-pouring .hero-liquid__toggle {
    visibility: hidden;
  }

  @media (max-width: 767px) {
    .hero-liquid__stage {
      background:
        radial-gradient(ellipse 70% 40% at 62% 28%, rgb(10 74 124 / 0.55), transparent 70%),
        linear-gradient(to top right, #04192b, var(--c-navy-900) 55%);
    }

    .hero-liquid__content {
      padding-bottom: 2.5rem;
    }

    .hero-liquid__actions .btn {
      flex: 1 1 100%;
    }

    .hero-liquid__toggle {
      top: calc(var(--header-h-mobile) + 1rem);
      bottom: auto;
      width: 44px;
      height: 44px;
    }
  }
</style>
