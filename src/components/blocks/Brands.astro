---
// Blok „Marki w ofercie”: dwaj partnerzy (ORLEN OIL, Castrol) jako duże karty
// z katalogami PDF, pozostałe marki w jednolitym, spokojnym rzędzie.
// Katalogi docelowo jako pliki w Sanity (klient podmienia je sam).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  anchor?: string;
  heading: string;
  text?: string;
  featured: readonly {
    name: string;
    logo: { src: ImageMetadata; alt: string };
    text: string;
    catalog?: { href: string; size: string };
  }[];
  othersHeading: string;
  others: readonly { name: string; catalog?: { href: string; size: string } }[];
}

const { anchor, heading, text, featured, othersHeading, others } = Astro.props;
---

<section class="section section--alt brands" id={anchor} aria-labelledby="brands-heading">
  <div class="container">
    <div class="brands__head">
      <h2 id="brands-heading" class="brands__title">{heading}</h2>
      {text && <p class="brands__text">{text}</p>}
    </div>

    <ul class="brands__featured" role="list">
      {
        featured.map((brand) => (
          <li class="brand">
            <div class="brand__logo">
              <Image src={brand.logo.src} alt={brand.logo.alt} width={286} height={82} />
            </div>
            <div class="brand__body">
              <h3 class="brand__name">{brand.name}</h3>
              <p class="brand__text">{brand.text}</p>
              {brand.catalog && (
                <a class="brand__catalog" href={brand.catalog.href} target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="2" />
                  </svg>
                  Katalog {brand.name}
                  <span class="brand__meta">PDF, {brand.catalog.size}</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="brands__others">
      <h3 class="brands__others-title">{othersHeading}</h3>
      <ul class="others" role="list">
        {
          others.map((brand) => (
            <li class="other">
              <span class="other__name">{brand.name}</span>
              {brand.catalog && (
                <a class="other__catalog" href={brand.catalog.href} target="_blank" rel="noopener">
                  Katalog<span class="visually-hidden"> {brand.name}</span> PDF, {brand.catalog.size}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .brands__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .brands__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .brands__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  .brands__featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand {
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
  }

  .brand__logo {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--c-bg-alt);
  }

  .brand__logo img {
    width: min(260px, 70%);
    height: auto;
  }

  .brand__body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  .brand__name {
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .brand__text {
    max-width: 48ch;
    margin-top: 0.75rem;
    color: var(--c-muted);
  }

  .brand__catalog {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem 0.625rem;
    margin-top: auto;
    padding-top: 1.75rem;
    font-weight: 700;
    color: var(--c-heading);
    text-decoration: none;
  }

  .brand__catalog:hover {
    text-decoration: underline;
  }

  .brand__meta {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-muted);
  }

  .brands__others {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 2fr);
    gap: 1.5rem 3rem;
    align-items: center;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .brands__others-title {
    font-size: 1.125rem;
    color: var(--c-heading);
  }

  .others {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Marki bez oficjalnych logotypów: jednolite nazwy zamiast mieszanki logo
     (do podmiany na monochromatyczne logotypy, gdy dostaniemy pliki) */
  .other {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    min-height: 88px;
    padding: 1rem 1.25rem;
    background: #fff;
  }

  .other__name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--c-muted);
  }

  .other__catalog {
    font-size: var(--fs-small);
    color: var(--c-heading);
  }

  @media (max-width: 1100px) {
    .brands__others {
      grid-template-columns: 1fr;
    }

    .others {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .brands__head,
    .brands__featured {
      grid-template-columns: 1fr;
    }

    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
