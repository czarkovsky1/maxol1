---
// Blok „Wiedza”: 3 ostatnie wpisy z bloga (docelowo zapytanie GROQ
// o najnowsze dokumenty „Wpis blogowy”). Układ jak „Aktualności” na orlen.pl.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  text?: string;
  link?: { label: string; href: string };
  posts: readonly { slug: string; title: string; excerpt: string; image: { src: ImageMetadata; alt: string } }[];
}

const { heading, text, link, posts } = Astro.props;
---

<section class="section articles" aria-labelledby="articles-heading">
  <div class="container">
    <div class="articles__head">
      <div>
        <h2 id="articles-heading" class="articles__title">{heading}</h2>
        {text && <p class="articles__text">{text}</p>}
      </div>
      {
        link && (
          <a class="link-arrow" href={link.href}>
            {link.label}
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </a>
        )
      }
    </div>

    <ul class="articles__list" role="list">
      {
        posts.map((post) => (
          <li>
            <a class="post" href={`/blog/${post.slug}`}>
              <div class="post__media">
                <Image src={post.image.src} alt={post.image.alt} widths={[400, 768]} sizes="(max-width: 800px) 100vw, 420px" />
              </div>
              <h3 class="post__title">{post.title}</h3>
              <p class="post__excerpt">{post.excerpt}</p>
              <span class="link-arrow post__more">
                Czytaj
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .articles__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .articles__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .articles__text {
    max-width: 52ch;
    margin-top: 1.25rem;
    color: var(--c-muted);
  }

  .articles__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .post__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--c-navy-900);
  }

  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .post:hover .post__media img {
    transform: scale(1.04);
  }

  .post__title {
    margin-top: 1.5rem;
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .post:hover .post__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .post__excerpt {
    margin-top: 0.75rem;
    color: var(--c-muted);
  }

  .post__more {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .articles__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .articles__list {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
