---
// Blok „Partnerzy i liczby”: sponsorzy ORLEN OIL i Castrol + potwierdzone liczby.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  text?: string;
  link?: { label: string; href: string };
  logos: readonly { src: ImageMetadata; alt: string }[];
  prevType?: string;
}

const { heading, text, link, logos, prevType } = Astro.props;
---

<section class:list={['partners', { 'partners--after-liquid': prevType === 'heroLiquid' }]} aria-labelledby="partners-heading">
  <div class="container">
    <div class="partners__top">
      <div class="partners__copy">
        <h2 id="partners-heading" class="partners__title">{heading}</h2>
        {text && <p class="partners__text">{text}</p>}
        {
          link && (
            <a class="link-arrow partners__link" href={link.href}>
              {link.label}
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
            </a>
          )
        }
      </div>

      <ul class="partners__logos" role="list">
        {
          logos.map((logo) => (
            <li class="partners__logo">
              <Image src={logo.src} alt={logo.alt} width={286} height={82} />
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<style>
  /* Równe, niższe odstępy góra/dół. Po hero z kroplą górę skraca biały pas tafli
     (8% wysokości ekranu), więc odejmujemy go od górnego paddingu. */
  .partners {
    --partners-y: clamp(3.5rem, 2.5rem + 3.5vw, 6rem);
    padding-block: var(--partners-y);
  }

  .partners--after-liquid {
    padding-top: max(0px, calc(var(--partners-y) - 8svh));
  }

  .partners__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: center;
  }

  .partners__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .partners__text {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--c-muted);
  }

  .partners__link {
    margin-top: 1.75rem;
  }

  .partners__logos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners__logo {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border: 1px solid var(--c-line);
    background: #fff;
  }

  .partners__logo img {
    width: 100%;
    max-width: 240px;
    height: auto;
  }

  @media (max-width: 900px) {
    .partners__top {
      grid-template-columns: 1fr;
    }

  }
</style>
