---
// Blok „Oferta”: rozwijane panele. Na desktopie 7 pionowych pasów, najechany
// (lub wybrany z klawiatury) rozszerza się i pokazuje zdjęcie, opis i link.
// Na telefonie: lista kart rozwijanych dotknięciem. Pierwszy panel otwarty od startu,
// więc bez JavaScriptu też wszystko jest czytelne i klikalne.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  anchor?: string;
  heading: string;
  text?: string;
  items: readonly { slug: string; title: string; excerpt: string; image: { src: ImageMetadata; alt: string } }[];
}

const { anchor, heading, text, items } = Astro.props;
---

<section class="section section--alt offer" id={anchor} aria-labelledby="offer-heading">
  <div class="container">
    <div class="offer__head">
      <h2 id="offer-heading" class="offer__title">{heading}</h2>
      {text && <p class="offer__text">{text}</p>}
    </div>

    <ul class="panels" role="list" data-panels>
      {
        items.map((item, i) => (
          <li class:list={['panel', { 'is-active': i === 0 }]} data-panel>
            <a class="panel__link" href={`/oferta/${item.slug}`}>
              <Image
                class="panel__img"
                src={item.image.src}
                alt={item.image.alt}
                widths={[480, 960]}
                sizes="(max-width: 900px) 100vw, 640px"
              />
              <span class="panel__shade" aria-hidden="true" />
              <span class="panel__label" aria-hidden="true">
                {item.title}
              </span>
              <span class="panel__body">
                <h3 class="panel__title">{item.title}</h3>
                <span class="panel__text">{item.excerpt}</span>
                <span class="panel__more">
                  Więcej
                  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                    <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Aktywacja panelu: najechanie myszą, fokus z klawiatury, a na dotyku
  // pierwsze dotknięcie rozwija panel (drugie przechodzi do podstrony).
  document.querySelectorAll<HTMLElement>('[data-panels]').forEach((list) => {
    const panels = [...list.querySelectorAll<HTMLElement>('[data-panel]')];
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const activate = (panel: HTMLElement) => panels.forEach((p) => p.classList.toggle('is-active', p === panel));

    panels.forEach((panel) => {
      if (canHover) panel.addEventListener('pointerenter', () => activate(panel));
      // tylko fokus z klawiatury (Tab); klik myszą/dotyk obsługuje handler poniżej
      panel.addEventListener('focusin', (e) => {
        if ((e.target as HTMLElement).matches(':focus-visible')) activate(panel);
      });
      panel.querySelector('a')?.addEventListener('click', (e) => {
        if (!panel.classList.contains('is-active')) {
          e.preventDefault();
          activate(panel);
        }
      });
    });
  });
</script>

<style>
  .offer__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .offer__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .offer__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  /* --- Desktop: pionowe pasy --- */
  .panels {
    display: flex;
    gap: 6px;
    height: clamp(460px, 62vh, 620px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    background: var(--c-navy-900);
    transition: flex-grow 0.65s var(--ease);
  }

  .panel.is-active {
    flex-grow: 5.2;
  }

  .panel__link {
    position: absolute;
    inset: 0;
    display: block;
    color: #fff;
    text-decoration: none;
  }

  .panel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    filter: saturate(0.85);
    transition:
      transform 0.9s var(--ease),
      filter 0.6s var(--ease);
  }

  .panel.is-active .panel__img {
    transform: scale(1);
    filter: none;
  }

  /* Przyciemnienie: zwinięte pasy ciemniejsze, aktywny jaśniejszy z gradientem pod tekstem.
     Biały tekst na granacie ≥ 0,85 krycia ma kontrast > 10:1. */
  .panel__shade {
    position: absolute;
    inset: 0;
    background: rgb(6 43 73 / 0.72);
    transition: background-color 0.5s var(--ease);
  }

  .panel.is-active .panel__shade {
    background: linear-gradient(to top, rgb(4 22 38 / 0.94) 0%, rgb(4 22 38 / 0.7) 38%, rgb(4 22 38 / 0.05) 72%);
  }

  .panel__label {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: opacity 0.3s var(--ease);
  }

  .panel.is-active .panel__label {
    opacity: 0;
  }

  .panel:not(.is-active):hover .panel__shade {
    background: rgb(6 43 73 / 0.6);
  }

  /* Treść ma stałą szerokość, więc nie przelewa się w trakcie rozwijania */
  .panel__body {
    position: absolute;
    left: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: min(420px, 80%);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
    pointer-events: none;
  }

  .panel.is-active .panel__body {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s var(--ease) 0.3s,
      transform 0.45s var(--ease) 0.3s;
  }

  .panel__title {
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.375rem);
    color: #fff;
  }

  .panel__text {
    max-width: 40ch;
    color: rgb(255 255 255 / 0.88);
  }

  .panel__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--c-yellow);
  }

  .panel__more svg {
    transition: transform 0.2s var(--ease);
  }

  .panel__link:hover .panel__more svg {
    transform: translateX(4px);
  }

  .panel__link:focus-visible {
    outline-offset: -4px;
  }

  /* --- Tablet i telefon: lista rozwijanych kart --- */
  @media (max-width: 900px) {
    .offer__head {
      grid-template-columns: 1fr;
    }

    .panels {
      flex-direction: column;
      height: auto;
    }

    .panel {
      flex: none;
      height: 76px;
      transition: height 0.55s var(--ease);
    }

    .panel.is-active {
      height: 400px;
    }

    .panel__label {
      left: 1.25rem;
      right: 3.5rem;
      top: 50%;
      bottom: auto;
      writing-mode: horizontal-tb;
      transform: translateY(-50%);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .panel:not(.is-active) .panel__link::after {
      content: '';
      position: absolute;
      right: 1.5rem;
      top: 50%;
      width: 10px;
      height: 10px;
      border-right: 2px solid #fff;
      border-bottom: 2px solid #fff;
      transform: translateY(-70%) rotate(45deg);
    }

    .panel__body {
      left: 1.25rem;
      right: 1.25rem;
      bottom: 1.5rem;
      width: auto;
    }
  }
</style>
