---
// Zaproszenie do kontaktu na końcu podstron: karta na białym tle (oddzielona od
// granatowej stopki) — zdjęcie + panel w granacie marki z telefonem i e-mailem.
import { Image } from 'astro:assets';
import { siteSettings } from '../data/site';
import defaultImage from '../assets/stock/handlowiec-tablet.jpg';

interface Props {
  heading?: string;
  text?: string;
  /** górny odstęp, gdy wcześniejsza sekcja ma szare tło */
  spaced?: boolean;
}

const {
  heading = 'Porozmawiajmy o dostawach dla Twojej firmy',
  text = 'Przedstawiciel z Twojego regionu dobierze produkty i przygotuje ofertę.',
  spaced = false,
} = Astro.props;
---

<section class:list={['cta', { 'cta--spaced': spaced }]} aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta__card">
      <div class="cta__media">
        <Image src={defaultImage} alt="Przedstawiciel handlowy z tabletem w magazynie" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 40vw" />
      </div>

      <div class="cta__panel">
        <svg class="cta__drop" viewBox="0 0 20 26" aria-hidden="true">
          <path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0z" fill="currentColor" />
        </svg>
        <h2 id="cta-heading" class="cta__title">{heading}</h2>
        <p class="cta__text">{text}</p>
        <a class="btn btn--primary cta__btn" href="/kontakt">Zapytaj o ofertę</a>

        <dl class="cta__contacts">
          <div>
            <dt>Dział handlowy</dt>
            <dd><a class="cta__phone" href={siteSettings.phone.href}>{siteSettings.phone.display}</a></dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a class="cta__mail" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bez górnego odstępu: na podstronach przed kartą jest biała sekcja z własnym odstępem;
     dolny odstęp oddziela kartę od granatowej stopki */
  .cta {
    padding-block: 0 var(--section-y);
    background: #fff;
  }

  .cta--spaced {
    padding-top: var(--section-y);
  }

  .cta__card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    min-height: 480px;
    overflow: hidden;
  }

  .cta__media {
    position: relative;
    background: var(--c-navy-900);
  }

  .cta__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Panel w granacie marki (#0A4A7C) — inny odcień niż stopka (#062B49) */
  .cta__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 1.5rem + 3vw, 4.5rem);
    background: var(--c-navy);
    color: #fff;
    overflow: hidden;
  }

  /* Duża kropla z logo jako znak wodny */
  .cta__drop {
    position: absolute;
    right: -6%;
    bottom: -22%;
    width: 46%;
    color: rgb(255 255 255 / 0.06);
    pointer-events: none;
  }

  .cta__title {
    position: relative;
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .cta__text {
    position: relative;
    max-width: 48ch;
    margin-top: 1.25rem;
    color: rgb(255 255 255 / 0.85);
  }

  .cta__btn {
    position: relative;
    align-self: flex-start;
    margin-top: 2rem;
  }

  .cta__contacts {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .cta__contacts dt {
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.78);
  }

  .cta__contacts dd {
    margin: 0.25rem 0 0;
  }

  .cta__contacts a {
    color: #fff;
    text-decoration: none;
  }

  .cta__contacts a:hover {
    text-decoration: underline;
  }

  .cta__phone {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cta__mail {
    display: inline-block;
    padding-top: 0.4em;
    font-size: 1.125rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .cta__card {
      grid-template-columns: 1fr;
    }

    .cta__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
