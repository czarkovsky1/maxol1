---
// PLAC ZABAW: kopia strony głównej z wariantem hero w three.js (kropla oleju).
// Docelowo tu będzie prawdziwa podstrona „O nas”. Do tego czasu noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { homePage } from '../data/home';

const blocks = homePage.blocks.map((block) =>
  block._type === 'hero' ? { ...block, _type: 'heroLiquid', _key: 'hero-liquid' } : block,
);
---

<BaseLayout
  title="O nas (wersja testowa) – Maxol"
  description="Wariant testowy strony z animowaną kroplą oleju."
  transparentHeader
  noindex
>
  <BlockRenderer blocks={blocks} />
</BaseLayout>
