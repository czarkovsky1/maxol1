---
// Dobierz olej: hero → co sprawdzić na etykiecie (interaktywnie) → doborniki producentów
// → poradniki → kontakt z doradcą. Ścieżka dla warsztatów i kierowców (B2C obok B2B).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LabelGuide from '../components/finder/LabelGuide.astro';
import FinderList from '../components/finder/FinderList.astro';
import PostList from '../components/PostList.astro';
import CtaBand from '../components/CtaBand.astro';
import { posts } from '../data/posts';
import heroImg from '../assets/stock/dobor-bagnet.jpg';

const guides = posts.filter((p) => ['jak-dobrac-olej-do-ciagnika', 'glikol-etylenowy-czy-propylenowy'].includes(p.slug));
---

<BaseLayout
  title="Dobierz olej do pojazdu lub maszyny – Maxol"
  description="Sprawdź, jak łatwo dobrać odpowiedni olej do swojego pojazdu lub maszyny. Doborniki producentów Castrol, ORLEN OIL, Total i Shell oraz pomoc doradców Maxol."
>
  <PageHero
    title="Dobierz olej do pojazdu lub maszyny"
    lead="Sprawdź oznaczenia w instrukcji, skorzystaj z dobornika producenta albo zapytaj naszego doradcę. Pomożemy dobrać olej do samochodu, ciężarówki, ciągnika czy maszyny."
    crumbs={[{ label: 'Dobierz olej' }]}
    image={{ src: heroImg, alt: 'Mechanik trzyma bagnet do pomiaru poziomu oleju' }}
    imagePosition="50% 45%"
    size="lg"
  >
    <div class="hero-actions">
      <a class="btn btn--primary" href="#doborniki">Doborniki producentów</a>
      <a class="link-arrow" href="/kontakt#formularz">
        Zapytaj doradcę
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </a>
    </div>
  </PageHero>

  <LabelGuide
    heading="Co sprawdzić przed wyborem oleju"
    text="Wymagania znajdziesz w instrukcji obsługi pojazdu lub maszyny. Te same oznaczenia są na etykiecie każdego oleju."
    items={[
      {
        id: 'lepkosc',
        title: 'Lepkość',
        example: 'np. SAE 5W-30',
        text: 'Liczba z literą W opisuje zachowanie oleju w niskiej temperaturze, druga liczba — w temperaturze pracy silnika. Wybierz klasę wskazaną przez producenta.',
      },
      {
        id: 'normy',
        title: 'Normy jakościowe',
        example: 'np. ACEA C3, API SP',
        text: 'Określają wymagania wobec oleju, m.in. ochronę silnika i zgodność z układami oczyszczania spalin. Olej powinien spełniać normę z instrukcji.',
      },
      {
        id: 'aprobaty',
        title: 'Aprobaty producenta',
        example: 'np. VW 504 00',
        text: 'Potwierdzają, że olej przeszedł testy producenta pojazdu lub maszyny. Jeśli instrukcja wymaga aprobaty, wybierz olej, który ją ma.',
      },
    ]}
  />

  <FinderList
    heading="Doborniki producentów"
    text="Wpisz markę i model pojazdu lub maszyny w wyszukiwarce producenta. Wyniki mają charakter informacyjny — przed zakupem porównaj je z instrukcją albo zapytaj naszego doradcę."
  />

  <section class="section section--alt" aria-labelledby="dg-heading">
    <div class="container">
      <div class="dg__head">
        <h2 id="dg-heading" class="dg__title">Poradniki</h2>
        <a class="link-arrow" href="/blog">
          Wszystkie artykuły
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </a>
      </div>
      <PostList posts={guides} layout="pair" />
    </div>
  </section>

  <CtaBand
    heading="Nie znalazłeś odpowiedniego oleju?"
    text="Podaj markę, model i rok produkcji pojazdu lub maszyny, a doradca Maxol wskaże właściwy produkt."
    spaced
  />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal(['.guide__copy', '.bottle-wrap', '.finders__list > li', '.plist > li', '.cta__card']);
</script>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
  }

  .dg__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 3rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .dg__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }
</style>
