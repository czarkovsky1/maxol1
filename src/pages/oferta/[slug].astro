---
// Podstrona kategorii oferty: /oferta/[slug] (adresy jak na starej stronie).
// Docelowo dane z Sanity (dokument „Usługa”), teraz z src/data/services.ts.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { siteSettings } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const drawings = ('drawings' in service && service.drawings) || [];
const h1 = 'h1' in service && service.h1 ? service.h1 : service.title;
const ask = 'ask' in service && service.ask ? service.ask : service.title.toLowerCase();
---

<BaseLayout title={service.seo.title} description={service.seo.description}>
  <PageHero
    title={h1}
    lead={service.excerpt}
    crumbs={[{ label: 'Oferta', href: '/oferta' }, { label: service.title }]}
    image={service.image}
  />

  <section class="section">
    <div class="container detail">
      <div class="prose detail__body">
        {service.body.map((p) => <p>{p}</p>)}
      </div>

      <aside class="detail__aside" aria-label="Zapytanie o ofertę">
        {
          service.brands.length > 0 && (
            <div class="aside-block">
              <h2 class="aside-block__title">Marki w tej kategorii</h2>
              <ul class="chips" role="list">
                {service.brands.map((b) => (
                  <li>
                    <a href="/marki#katalogi">{b}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="aside-block">
          <h2 class="aside-block__title">Zapytaj o {ask}</h2>
          <p class="aside-block__text">Przedstawiciel z Twojego regionu dobierze produkty i przygotuje ofertę.</p>
          <a class="btn btn--primary aside-block__btn" href="/kontakt">Zapytaj o ofertę</a>
          <a class="aside-block__phone" href={siteSettings.phone.href}>
            lub zadzwoń: <strong>{siteSettings.phone.display}</strong>
          </a>
        </div>
      </aside>
    </div>
  </section>

  {
    drawings.length > 0 && (
      <section class="section section--alt" aria-labelledby="drawings-heading">
        <div class="container">
          <h2 id="drawings-heading" class="drawings__title">Ryciny techniczne</h2>
          <ul class="drawings" role="list">
            {drawings.map((d) => (
              <li>
                <a class="drawing" href={d.pdf} target="_blank" rel="noopener">
                  <span class="drawing__img">
                    <Image src={d.image} alt={`Rycina techniczna: ${d.title}`} widths={[400, 800]} sizes="(max-width: 700px) 90vw, 360px" />
                  </span>
                  <span class="drawing__title">{d.title}</span>
                  <span class="drawing__meta">Rycina PDF, {d.size}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ServiceCards items={others} heading="Pozostałe kategorie" />
  <CtaBand />
</BaseLayout>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem 5rem;
    align-items: start;
  }

  .detail__body {
    font-size: 1.125rem;
  }

  .detail__aside {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 1rem;
  }

  .aside-block {
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    background: var(--c-bg-alt);
  }

  .aside-block__title {
    font-size: 1.25rem;
    color: var(--c-heading);
  }

  .aside-block__text {
    margin-top: 0.5rem;
    color: var(--c-muted);
  }

  .aside-block__btn {
    margin-top: 1.25rem;
    width: 100%;
  }

  .aside-block__phone {
    display: block;
    margin-top: 1rem;
    color: var(--c-muted);
    text-decoration: none;
  }

  .aside-block__phone strong {
    color: var(--c-heading);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-heading);
    text-decoration: none;
  }

  .chips a:hover {
    border-color: var(--c-heading);
  }

  .drawings__title {
    margin-bottom: 2rem;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .drawings {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 320px));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawing {
    display: grid;
    gap: 0.375rem;
    text-decoration: none;
  }

  .drawing__img {
    display: block;
    padding: 1rem;
    background: #fff;
  }

  .drawing__title {
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--c-heading);
  }

  .drawing:hover .drawing__title {
    text-decoration: underline;
  }

  .drawing__meta {
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .detail {
      grid-template-columns: 1fr;
    }

    .detail__aside {
      position: static;
    }
  }
</style>
