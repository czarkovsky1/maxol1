---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { homePage } from '../data/home';
import { siteSettings } from '../data/site';

const contact = homePage.blocks
  .filter((b) => b._type === 'contact')
  .map((b) => ({ ...b, anchor: 'formularz', heading: 'Formularz kontaktowy' }));
const reg = siteSettings.registry;
const a = siteSettings.address;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${a.street}, ${a.postalCode} ${a.city}`)}`;
---

<BaseLayout
  title="Kontakt z firmą Maxol z Suchedniowa – zapraszamy do współpracy"
  description="Skontaktuj się z firmą Maxol z Suchedniowa, aby omówić ofertę olejów i smarów dla Twojej branży. Telefon 881 852 852, biuro@maxol.pl."
  ctaHref="#formularz"
>
  <PageHero
    title="Kontakt z firmą Maxol"
    lead="Zadzwoń, napisz albo wypełnij formularz. Przedstawiciel z Twojego regionu odpowie na zapytanie i przygotuje ofertę."
    crumbs={[{ label: 'Kontakt' }]}
  >
    <div class="quick">
      <a class="quick__phone" href={siteSettings.phone.href}>{siteSettings.phone.display}</a>
      <a class="quick__mail" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
    </div>
  </PageHero>

  <BlockRenderer blocks={contact} />

  <section class="section section--alt" aria-labelledby="company-heading">
    <div class="container company">
      <div>
        <h2 id="company-heading" class="company__title">Dane firmy</h2>
        <dl class="company__data">
          <div><dt>Nazwa</dt><dd>{reg.fullName}</dd></div>
          <div><dt>Adres</dt><dd>{a.street}, {a.postalCode} {a.city}</dd></div>
          <div><dt>Sąd rejestrowy</dt><dd>{reg.court}</dd></div>
          <div><dt>KRS</dt><dd>{reg.krs}</dd></div>
          <div><dt>NIP</dt><dd>{reg.nip}</dd></div>
          <div><dt>REGON</dt><dd>{reg.regon}</dd></div>
          <div><dt>Kapitał zakładowy</dt><dd>{reg.capital}</dd></div>
        </dl>
      </div>
      <div class="company__map">
        <h2 class="company__title">Dojazd</h2>
        <p>
          Centrum Dystrybucji Maxol znajduje się w Suchedniowie, przy ul. Zagórskiej 20B (powiat skarżyski, województwo świętokrzyskie).
        </p>
        <a class="btn btn--ghost" href={mapUrl} target="_blank" rel="noopener">Pokaż na mapie Google<span class="visually-hidden"> (nowa karta)</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quick {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-top: 2rem;
  }

  .quick__phone {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-heading);
    text-decoration: none;
  }

  .quick__mail {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--c-heading);
  }

  .company {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2.5rem 5rem;
  }

  .company__title {
    margin-bottom: 1.25rem;
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .company__data {
    display: grid;
    gap: 0.625rem;
    margin: 0;
  }

  .company__data div {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1rem;
  }

  .company__data dt {
    color: var(--c-muted);
  }

  .company__data dd {
    margin: 0;
    font-weight: 600;
    color: var(--c-ink);
  }

  .company__map p {
    max-width: 46ch;
    margin-bottom: 1.5rem;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .company {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .company__data div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
