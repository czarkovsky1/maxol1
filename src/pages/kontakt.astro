---
// Kontakt: hero z szybkim kontaktem → formularz + „co dalej” → przedstawiciele i działy
// → siedziba z mapą obszaru dostaw i danymi rejestrowymi.
// Dane kontaktowe z src/data/site.ts i bloku „contact” (docelowo „Ustawienia globalne” w Sanity).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { homePage } from '../data/home';
import { siteSettings } from '../data/site';
import { voivodeships, mapViewBox, suchedniow } from '../data/poland-map';

const contact = homePage.blocks.find((b) => b._type === 'contact')!;
const process = homePage.blocks.find((b) => b._type === 'process')!;
const reach = homePage.blocks.find((b) => b._type === 'reach')!;
const departments = 'departments' in contact ? contact.departments : [];
const reps = 'reps' in contact ? contact.reps : [];
const steps = 'steps' in process ? process.steps : [];
const regions: readonly string[] = 'regions' in reach ? reach.regions : [];
const served = new Set(regions);

const reg = siteSettings.registry;
const a = siteSettings.address;
const mapUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${a.street}, ${a.postalCode} ${a.city}`)}`;
const tel = (p: string) => `tel:+48${p.replace(/\D/g, '')}`;
---

<BaseLayout
  title="Kontakt z firmą Maxol z Suchedniowa – zapraszamy do współpracy"
  description="Skontaktuj się z firmą Maxol z Suchedniowa, aby omówić ofertę olejów i smarów dla Twojej branży. Telefon 881 852 852, biuro@maxol.pl."
  ctaHref="#formularz"
>
  <PageHero
    title="Kontakt z Maxol"
    lead="Zadzwoń, napisz albo wypełnij formularz. Przedstawiciel z Twojego regionu odpowie na zapytanie i przygotuje ofertę."
    crumbs={[{ label: 'Kontakt' }]}
  >
    <div class="hero-actions">
      <a class="btn btn--primary" href="#formularz">Wypełnij formularz</a>
      <a class="link-arrow" href="#przedstawiciele">
        Przedstawiciele handlowi
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M9 3v11M4.5 10L9 14.5 13.5 10" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </a>
    </div>

    <div slot="aside" class="qcard">
      <svg class="qcard__drop" viewBox="0 0 20 26" aria-hidden="true">
        <path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0z" fill="currentColor" />
      </svg>
      <p class="qcard__label">Dział handlowy</p>
      <a class="qcard__phone" href={siteSettings.phone.href}>{siteSettings.phone.display}</a>
      <dl class="qcard__list">
        <div>
          <dt>Biuro</dt>
          <dd><a href={siteSettings.phoneOffice.href}>{siteSettings.phoneOffice.display}</a></dd>
        </div>
        <div>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></dd>
        </div>
        <div>
          <dt>Adres</dt>
          <dd>{a.street}, {a.postalCode} {a.city}</dd>
        </div>
      </dl>
    </div>
  </PageHero>

  <section class="section section--alt formsec" id="formularz" aria-labelledby="form-heading">
    <div class="container formsec__grid">
      <div class="formsec__card">
        <h2 id="form-heading" class="formsec__title">Zapytaj o ofertę</h2>
        <p class="formsec__text">Opisz, czego potrzebujesz. Wybierz województwo, a odezwie się przedstawiciel z Twojego regionu.</p>
        <ContactForm />
      </div>

      <aside class="next" aria-labelledby="next-heading">
        <h2 id="next-heading" class="next__title">Co dalej?</h2>
        <ol class="next__list" role="list">
          {
            steps.map((s, i) => (
              <li class="nstep">
                <span class="nstep__num" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3 class="nstep__title">{s.title}</h3>
                  <p class="nstep__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>

  <section class="section people" id="przedstawiciele" aria-labelledby="people-heading">
    <div class="container">
      <div class="people__head">
        <h2 id="people-heading" class="people__title">Przedstawiciele handlowi</h2>
        <p class="people__text">Zadzwoń bezpośrednio do przedstawiciela albo wyślij zapytanie przez formularz — przekażemy je osobie z Twojego regionu.</p>
      </div>

      <ul class="reps" role="list">
        {
          reps.map((r) => (
            <li class="rep">
              <h3 class="rep__name">{r.name}</h3>
              <p class="rep__role">Przedstawiciel handlowy</p>
              <a class="rep__phone" href={tel(r.phone)}>{r.phone}</a>
              <a class="rep__mail" href={`mailto:${r.email}`}>{r.email}</a>
            </li>
          ))
        }
      </ul>

      <h2 class="people__sub">Działy</h2>
      <ul class="depts" role="list">
        {
          departments.map((d) => (
            <li class="dept">
              <h3 class="dept__name">{d.name}</h3>
              <p class="dept__phones">
                {d.phones.map((p, i) => (
                  <>
                    {i > 0 && <br />}
                    <a href={tel(p)}>{p}</a>
                  </>
                ))}
              </p>
              {d.email && (
                <a class="dept__mail" href={`mailto:${d.email}`}>
                  {d.email}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt place" aria-labelledby="place-heading">
    <div class="container place__grid">
      <div class="place__copy">
        <h2 id="place-heading" class="place__title">Siedziba i&nbsp;Centrum Dystrybucji</h2>
        <address class="place__address">
          {siteSettings.legalName}<br />
          {a.street}<br />
          {a.postalCode} {a.city}
        </address>
        <p class="place__text">Powiat skarżyski, województwo świętokrzyskie. Stąd własną flotą dowozimy towar do firm w siedmiu województwach.</p>
        <a class="btn btn--ghost" href={mapUrl} target="_blank" rel="noopener">
          Wyznacz trasę<span class="visually-hidden"> w Mapach Google (nowa karta)</span>
        </a>

        <h3 class="place__sub">Dane firmy</h3>
        <dl class="regdata">
          <div><dt>Nazwa</dt><dd>{reg.fullName}</dd></div>
          <div><dt>Sąd rejestrowy</dt><dd>{reg.court}</dd></div>
          <div><dt>KRS</dt><dd>{reg.krs}</dd></div>
          <div><dt>NIP</dt><dd>{reg.nip}</dd></div>
          <div><dt>REGON</dt><dd>{reg.regon}</dd></div>
          <div><dt>Kapitał zakładowy</dt><dd>{reg.capital}</dd></div>
        </dl>
      </div>

      <figure class="pmap">
        <svg viewBox={mapViewBox} role="img" aria-label={`Mapa Polski. Obszar dostaw Maxol: ${regions.join(', ')}. Siedziba w Suchedniowie.`}>
          {voivodeships.map((v) => <path d={v.d} class:list={['pmap__region', { 'is-served': served.has(v.name) }]} />)}
          <g class="pmap__pin" transform={`translate(${suchedniow.x} ${suchedniow.y})`}>
            <circle class="pmap__pulse" r="10" />
            <path d="M0-30c0 0-11 12.6-11 18.6a11 11 0 0 0 22 0c0-6-11-18.6-11-18.6z" class="pmap__drop" />
            <circle r="3.4" cy="-11.4" fill="#062b49" />
          </g>
          <text x={suchedniow.x + 18} y={suchedniow.y - 8} class="pmap__label">Suchedniów</text>
        </svg>
        <figcaption class="pmap__legend">
          <span class="pmap__key pmap__key--served" aria-hidden="true"></span> Obszar dostaw: {regions.length} województw
        </figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal(['.formsec__card', '.next', '.rep', '.dept', '.place__copy', '.pmap']);
</script>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
  }

  /* Szybki kontakt w hero: panel w granacie marki */
  .qcard {
    position: relative;
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    overflow: hidden;
    background: var(--c-navy);
    color: #fff;
  }

  .qcard__drop {
    position: absolute;
    right: -8%;
    bottom: -26%;
    width: 44%;
    color: rgb(255 255 255 / 0.06);
  }

  .qcard__label {
    position: relative;
    font-weight: 700;
    color: rgb(255 255 255 / 0.85);
  }

  .qcard__phone {
    position: relative;
    display: inline-block;
    margin-top: 0.25rem;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #fff;
    text-decoration: none;
  }

  .qcard__phone:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-yellow);
  }

  .qcard__list {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .qcard__list div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
  }

  .qcard__list dt {
    color: rgb(255 255 255 / 0.78);
  }

  .qcard__list dd {
    margin: 0;
    font-weight: 600;
  }

  .qcard__list a {
    color: #fff;
    text-decoration: none;
  }

  .qcard__list a:hover {
    text-decoration: underline;
  }

  /* Formularz + co dalej */
  .formsec {
    scroll-margin-top: var(--header-h);
  }

  .formsec__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem clamp(3rem, 2rem + 4vw, 6rem);
    align-items: start;
  }

  .formsec__card {
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    background: #fff;
    border-top: 4px solid var(--c-yellow);
  }

  .formsec__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .formsec__text {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--c-muted);
  }

  .next {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    padding-top: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
  }

  .next__title {
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .next__list {
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* pionowa linia łącząca kroki */
  .next__list::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background: var(--c-line);
  }

  .nstep {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1rem;
  }

  .nstep__num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-heading);
    font-weight: 800;
    color: #fff;
  }

  .nstep:first-child .nstep__num {
    background: var(--c-yellow);
    color: var(--c-navy-900);
  }

  .nstep__title {
    padding-top: 0.375rem;
    font-size: 1.125rem;
    color: var(--c-heading);
  }

  .nstep__text {
    margin-top: 0.375rem;
    color: var(--c-muted);
  }

  /* Przedstawiciele i działy */
  .people {
    scroll-margin-top: var(--header-h);
  }

  .people__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .people__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .people__text {
    max-width: 52ch;
    color: var(--c-muted);
  }

  .reps,
  .depts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .depts {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rep,
  .dept {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    background: var(--c-bg-alt);
  }

  .rep {
    border-top: 4px solid var(--c-yellow);
  }

  .rep__name,
  .dept__name {
    font-size: 1.25rem;
    color: var(--c-heading);
  }

  .rep__role {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .rep__phone {
    margin-top: 1.5rem;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-heading);
    text-decoration: none;
  }

  .rep__mail,
  .dept__mail {
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--c-heading);
    overflow-wrap: anywhere;
  }

  .rep__phone:hover,
  .dept__phones a:hover {
    text-decoration: underline;
  }

  .people__sub {
    margin: clamp(3rem, 2.5rem + 2vw, 4.5rem) 0 1.5rem;
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  .dept__phones {
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .dept__phones a {
    color: var(--c-heading);
    text-decoration: none;
  }

  /* Siedziba + mapa */
  .place__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }

  .place__title {
    max-width: 14ch;
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  .place__address {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-style: normal;
    font-weight: 700;
    line-height: 1.35;
    color: var(--c-heading);
  }

  .place__text {
    max-width: 46ch;
    margin: 1rem 0 1.75rem;
    color: var(--c-muted);
  }

  .place__sub {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-size: 1.125rem;
    color: var(--c-heading);
  }

  .regdata {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }

  .regdata div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1rem;
  }

  .regdata dt {
    color: var(--c-muted);
  }

  .regdata dd {
    margin: 0;
    font-weight: 600;
    color: var(--c-ink);
  }

  .pmap {
    margin: 0;
  }

  .pmap svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pmap__region {
    fill: #dfe4e9;
    stroke: var(--c-bg-alt);
    stroke-width: 1.5;
  }

  .pmap__region.is-served {
    fill: var(--c-navy);
  }

  .pmap__drop {
    fill: var(--c-yellow);
    stroke: var(--c-navy-900);
    stroke-width: 2;
  }

  .pmap__pulse {
    fill: var(--c-yellow);
    opacity: 0.5;
    transform-origin: center;
    animation: pin-pulse 2.4s var(--ease) infinite;
  }

  @keyframes pin-pulse {
    0% {
      transform: scale(0.4);
      opacity: 0.6;
    }

    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .pmap__label {
    font: 800 17px var(--font);
    fill: #fff;
    paint-order: stroke;
    stroke: var(--c-navy-900);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .pmap__legend {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-heading);
  }

  .pmap__key {
    width: 18px;
    height: 18px;
    background: var(--c-navy);
  }

  @media (prefers-reduced-motion: reduce) {
    .pmap__pulse {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 1100px) {
    .reps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1000px) {
    .formsec__grid {
      grid-template-columns: 1fr;
    }

    .next {
      position: static;
      padding-top: 0;
    }
  }

  @media (max-width: 860px) {
    .people__head,
    .place__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .depts {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .reps {
      grid-template-columns: 1fr;
    }

    .regdata div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
