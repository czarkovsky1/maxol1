---
// Wpis blogowy. Docelowo dokument „Wpis blogowy” z Sanity (Portable Text).
// Układ: nagłówek (okruszki, H1, wstęp, czas czytania) → szerokie zdjęcie →
// treść ze spisem treści (przyklejony, podświetla bieżący rozdział) i paskiem
// postępu czytania w linii nagłówka → powiązana oferta → kolejne wpisy → kontakt.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostList from '../../components/PostList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, postTexts, type Post } from '../../data/posts';
import { services } from '../../data/services';
import { siteSettings } from '../../data/site';
import { readingMinutes, slugify } from '../../utils/text';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const related = services.filter((s) => post.related.includes(s.slug));
const more = posts.filter((p) => p.slug !== post.slug);
const minutes = readingMinutes(postTexts(post));
const sections = post.sections.map((s) => {
  const heading = 'heading' in s && s.heading ? s.heading : undefined;
  return { heading, id: heading ? slugify(heading) : undefined, paragraphs: s.paragraphs };
});
const toc = sections.filter((s) => s.heading);
---

<BaseLayout title={`${post.title} | Maxol`} description={post.excerpt}>
  <div class="read-progress" aria-hidden="true" data-progress></div>

  <header class="ahead">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: post.title }]} />
      <h1 class="ahead__title">{post.title}</h1>
      <p class="ahead__lead">{post.excerpt}</p>
      <p class="ahead__meta">
        <span>Poradnik</span>
        <span>{minutes} min czytania</span>
        {related.length > 0 && (
          <span>
            {related.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/oferta/${s.slug}`}>{s.title}</a>
              </>
            ))}
          </span>
        )}
      </p>
    </div>
  </header>

  <div class="container">
    <figure class="ahero">
      <Image src={post.image.src} alt={post.image.alt} widths={[640, 1000, 1400, 1800]} sizes="(max-width: 1400px) 100vw, 1320px" loading="eager" fetchpriority="high" />
    </figure>
  </div>

  <section class="section article-wrap">
    <div class:list={['container', 'article', { 'article--no-toc': toc.length <= 1 }]}>
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="Spis treści" data-toc>
            <p class="toc__title">W artykule</p>
            <ol class="toc__list" role="list">
              {toc.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-toc-link={s.id}>
                    {s.heading}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="article__main">
        <article class="prose article__body" data-article>
          {
            sections.map((s, i) => (
              <>
                {s.heading && <h2 id={s.id}>{s.heading}</h2>}
                {s.paragraphs.map((p, j) => (
                  <p class:list={{ 'article__first': i === 0 && j === 0 && !s.heading }}>{p}</p>
                ))}
              </>
            ))
          }
        </article>

        {
          related.length > 0 && (
            <aside class="rel" aria-labelledby="rel-heading">
              <h2 id="rel-heading" class="rel__title">Powiązana oferta</h2>
              <ul class="rel__list" role="list">
                {related.map((s) => (
                  <li>
                    <a class="rel__card" href={`/oferta/${s.slug}`}>
                      <span class="rel__img">
                        <Image src={s.image.src} alt="" widths={[240, 480]} sizes="120px" />
                      </span>
                      <span class="rel__body">
                        <span class="rel__name">{s.title}</span>
                        <span class="rel__more">
                          Zobacz ofertę
                          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
                            <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
                          </svg>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <div class="ask">
          <svg class="ask__drop" viewBox="0 0 20 26" aria-hidden="true">
            <path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0z" fill="currentColor" />
          </svg>
          <p class="ask__title">Masz pytanie do tego artykułu?</p>
          <p class="ask__text">Doradca Maxol pomoże dobrać produkt do Twojego pojazdu, maszyny lub zakładu.</p>
          <div class="ask__actions">
            <a class="btn btn--primary" href="/kontakt#formularz">Zapytaj doradcę</a>
            <a class="ask__phone" href={siteSettings.phone.href}>{siteSettings.phone.display}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="section section--alt" aria-labelledby="more-heading">
        <div class="container">
          <div class="more__head">
            <h2 id="more-heading" class="more__title">Przeczytaj także</h2>
            <a class="link-arrow" href="/blog">
              Wszystkie artykuły
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
            </a>
          </div>
          <PostList posts={more} layout="pair" />
        </div>
      </section>
    )
  }

  <CtaBand spaced={more.length > 0} />
</BaseLayout>

<script>
  // Pasek postępu czytania + podświetlenie bieżącego rozdziału w spisie treści
  import { initToc } from '../../scripts/toc';

  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (bar && article) {
    let ticking = false;
    const update = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.5;
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.35 - r.top) / Math.max(1, total)));
      bar.style.transform = `scaleX(${p})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  initToc(document.querySelector<HTMLElement>('[data-toc]'));
</script>

<style>
  /* Postęp czytania: granatowa linia rośnie na żółtej linii pod nagłówkiem */
  .read-progress {
    position: fixed;
    top: calc(var(--header-h) - 3px);
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    background: var(--c-navy-900);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  .ahead {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .ahead__title {
    max-width: 20ch;
    font-size: clamp(2.375rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--c-heading);
  }

  .ahead__lead {
    max-width: 56ch;
    margin-top: 1.5rem;
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem);
    color: var(--c-muted);
  }

  .ahead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-top: 1.75rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-heading);
  }

  .ahead__meta > span + span::before {
    content: '·';
    margin-inline: 0.625rem;
    color: var(--c-muted);
  }

  .ahead__meta a {
    color: var(--c-heading);
  }

  .ahero {
    position: relative;
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--c-navy-900);
  }

  .ahero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ahero::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(96px, 12vw, 180px);
    height: 6px;
    background: var(--c-yellow);
  }

  /* Treść + spis treści */
  .article {
    display: grid;
    grid-template-columns: minmax(200px, 0.55fr) minmax(0, 1.6fr);
    gap: 2.5rem clamp(3rem, 2rem + 4vw, 6.5rem);
    align-items: start;
  }

  .article__main {
    grid-column: 2;
  }

  .article--no-toc {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .article--no-toc .article__main {
    grid-column: auto;
    width: min(100%, 68ch);
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 2.5rem);
  }

  .toc__title {
    margin-bottom: 1rem;
    font-weight: 800;
    color: var(--c-heading);
  }

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--c-line);
  }

  .toc__list a {
    position: relative;
    display: block;
    padding: 0.5rem 0 0.5rem 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--c-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .toc__list a::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--c-yellow-600);
    transform: scaleY(0);
    transition: transform 0.25s var(--ease);
  }

  .toc__list a:hover,
  .toc__list a.is-active {
    color: var(--c-heading);
  }

  .toc__list a.is-active {
    font-weight: 700;
  }

  .toc__list a.is-active::before {
    transform: scaleY(1);
  }

  .article__body {
    max-width: 68ch;
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .article__body > :first-child {
    margin-top: 0;
  }

  .article__body :global(h2) {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .article__first {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--c-heading);
  }

  /* Powiązana oferta */
  .rel {
    max-width: 68ch;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    padding-top: 2rem;
    border-top: 3px solid var(--c-yellow);
  }

  .rel__title {
    font-size: 1.375rem;
    color: var(--c-heading);
  }

  .rel__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rel__card {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding-right: 1rem;
    background: var(--c-bg-alt);
    text-decoration: none;
  }

  .rel__img {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .rel__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rel__body {
    display: grid;
    gap: 0.375rem;
    padding-block: 0.75rem;
  }

  .rel__name {
    font-weight: 800;
    line-height: 1.2;
    color: var(--c-heading);
  }

  .rel__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-heading);
  }

  .rel__more svg {
    transition: transform 0.2s var(--ease);
  }

  .rel__card:hover .rel__more svg {
    transform: translateX(4px);
  }

  /* Pytanie do doradcy */
  .ask {
    position: relative;
    max-width: 68ch;
    margin-top: 2.5rem;
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    overflow: hidden;
    background: var(--c-navy);
    color: #fff;
  }

  .ask__drop {
    position: absolute;
    right: -4%;
    bottom: -30%;
    width: 30%;
    color: rgb(255 255 255 / 0.07);
  }

  .ask__title {
    position: relative;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .ask__text {
    position: relative;
    max-width: 46ch;
    margin-top: 0.625rem;
    color: rgb(255 255 255 / 0.85);
  }

  .ask__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.5rem;
  }

  .ask__phone {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
    text-decoration: none;
  }

  .ask__phone:hover {
    text-decoration: underline;
  }

  .more__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 3rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .more__title {
    font-size: var(--fs-h2);
    color: var(--c-heading);
  }

  @media (max-width: 1000px) {
    .article {
      grid-template-columns: 1fr;
    }

    .article__main {
      grid-column: auto;
    }

    .toc {
      position: static;
      padding: 1.25rem 1.5rem;
      background: var(--c-bg-alt);
    }
  }

  @media (max-width: 700px) {
    .ahero {
      aspect-ratio: 3 / 2;
      margin-inline: calc(-1 * var(--gutter));
    }

    .rel__list {
      grid-template-columns: 1fr;
    }

    .article__body {
      font-size: 1.0625rem;
    }
  }
</style>
