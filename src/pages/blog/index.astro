---
// Blog: hero → wyróżniony (najnowszy) wpis w dużym układzie → pozostałe wpisy jako wiersze → kontakt.
// Docelowo lista z Sanity (zapytanie GROQ o dokumenty „Wpis blogowy” od najnowszych).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostList from '../../components/PostList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, postTexts } from '../../data/posts';
import { services } from '../../data/services';
import { readingMinutes } from '../../utils/text';

const [featured, ...rest] = posts;
const featuredTopics = services.filter((s) => featured.related.includes(s.slug));
---

<BaseLayout
  title="Wiedza o olejach i smarach – poradniki | Maxol"
  description="Praktyczne poradniki o doborze olejów, smarów i płynów eksploatacyjnych dla warsztatów, flot, rolnictwa i przemysłu."
>
  <PageHero
    title="Wiedza o olejach i smarach"
    lead="Praktyczne poradniki o doborze olejów, smarów i płynów eksploatacyjnych. Dla warsztatów, flot, gospodarstw rolnych i zakładów przemysłowych."
    crumbs={[{ label: 'Blog' }]}
  />

  <section class="blog" aria-label="Artykuły">
    <div class="container">
      <article class="feat">
        <a class="feat__media" href={`/blog/${featured.slug}`} tabindex="-1" aria-hidden="true">
          <Image src={featured.image.src} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />
        </a>
        <div class="feat__body">
          <h2 class="feat__title">
            <a href={`/blog/${featured.slug}`}>{featured.title}</a>
          </h2>
          <p class="feat__excerpt">{featured.excerpt}</p>
          <p class="feat__meta">
            {readingMinutes(postTexts(featured))} min czytania
            {featuredTopics.length > 0 && <> · {featuredTopics.map((s) => s.title).join(', ')}</>}
          </p>
          <a class="link-arrow feat__more" href={`/blog/${featured.slug}`} aria-hidden="true" tabindex="-1">
            Czytaj artykuł
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </a>
        </div>
      </article>

      {
        rest.length > 0 && (
          <div class="blog__rest">
            <h2 class="blog__rest-title">Pozostałe artykuły</h2>
            <PostList posts={rest} />
          </div>
        )
      }
    </div>
  </section>

  <CtaBand heading="Masz pytanie o dobór oleju lub smaru?" text="Opisz pojazd, maszynę lub zastosowanie. Przedstawiciel z Twojego regionu doradzi produkt i przygotuje ofertę." />
</BaseLayout>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal(['.feat__body', '.blog__rest .plist > li', '.cta__card']);
</script>

<style>
  .blog {
    padding-bottom: var(--section-y);
  }

  /* Wyróżniony wpis: duże zdjęcie + karta z tekstem nachodząca na zdjęcie */
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
  }

  .feat__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-navy-900);
  }

  .feat__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .feat:hover .feat__media :global(img) {
    transform: scale(1.03);
  }

  .feat__body {
    position: relative;
    z-index: 1;
    margin-left: -18%;
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.75rem);
    background: #fff;
    border-top: 4px solid var(--c-yellow);
    box-shadow: 0 30px 60px -40px rgb(6 43 73 / 0.45);
  }

  .feat__title {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--c-heading);
  }

  .feat__title a {
    text-decoration: none;
  }

  .feat__title a::after {
    /* cała karta klikalna */
    content: '';
    position: absolute;
    inset: 0;
  }

  .feat:hover .feat__title a {
    text-decoration: underline;
    text-decoration-color: var(--c-yellow-600);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  .feat__excerpt {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--c-muted);
  }

  .feat__meta {
    margin-top: 1.25rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-heading);
  }

  .feat__more {
    margin-top: 1.75rem;
  }

  .blog__rest {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .blog__rest-title {
    margin-bottom: 1.5rem;
    font-size: var(--fs-h3);
    color: var(--c-heading);
  }

  @media (max-width: 900px) {
    .feat {
      grid-template-columns: 1fr;
    }

    .feat__body {
      margin: -3rem 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .feat__body {
      margin: 0;
      box-shadow: none;
      padding-inline: 0;
    }
  }
</style>
